# =============================================================================
# Poll in Cash Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control
# =============================================================================

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Neon Postgres connection string
# Get yours from: https://console.neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# JWT secret for signing authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-generate-with-openssl

# =============================================================================
# BLOCKCHAIN (Required for contract interactions)
# =============================================================================
# PollPool contract address on Base Sepolia
POLLPOOL_CONTRACT_ADDRESS=0x...

# Base Sepolia RPC URL (or use Base mainnet for production)
BASE_RPC_URL=https://sepolia.base.org

# USDC contract address
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Trusted attestation signer address (for verifying poll responses)
ATTESTATION_SIGNER_ADDRESS=0x...

# =============================================================================
# SERVER (Optional)
# =============================================================================
# Server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=development

# =============================================================================
# THIRDWEB (Phase 4)
# =============================================================================
# Thirdweb Client ID for SDK
# Get yours from: https://thirdweb.com/dashboard/settings/api-keys
THIRDWEB_CLIENT_ID=

# Thirdweb Secret Key (for server-side operations)
# This is required for backend contract interactions
THIRDWEB_SECRET_KEY=

# Server wallet private key for backend transactions
# Used for closePoll, distribute, and other server-initiated transactions
# Generate a new wallet and fund it with testnet ETH for gas
SERVER_WALLET_PRIVATE_KEY=0x...

# Deployer wallet private key (can be same as SERVER_WALLET_PRIVATE_KEY)
# Used for contract deployment via deploy.ts
DEPLOYER_PRIVATE_KEY=0x...

# =============================================================================
# COINBASE CDP (Phase 4)
# =============================================================================
# Coinbase Developer Platform API credentials
# Get yours from: https://portal.cdp.coinbase.com/
#
# IMPORTANT: The CDP_WALLET_SECRET is only shown ONCE during key creation.
# Save it immediately or you'll need to create a new key.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Treasury wallet address for x402 payments and platform fees
# Create with: npx tsx src/services/cdp/create-treasury.ts
TREASURY_WALLET_ADDRESS=0x...

# Optional: Paymaster URL for mainnet gasless transactions
# CDP_PAYMASTER_URL=https://paymaster.example.com

# =============================================================================
# x402 PAYMENTS (Phase 4)
# =============================================================================
# x402 Facilitator URL (defaults to https://facilitator.x402.org)
# X402_FACILITATOR_URL=https://facilitator.x402.org

# App name shown in x402 paywall UI
X402_APP_NAME=Poll in Cash

# App logo URL shown in x402 paywall UI (optional)
# X402_APP_LOGO=https://example.com/logo.png
