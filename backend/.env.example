# =============================================================================
# Poll in Cash Backend - Environment Variables (Production)
# =============================================================================

# =============================================================================
# DATABASE (Required)
# =============================================================================
# Neon PostgreSQL connection string
# Get from: https://neon.tech - use production database for prod
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# =============================================================================
# AUTHENTICATION (Required - GENERATE NEW FOR PRODUCTION)
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-32-byte-random-secret-here

# =============================================================================
# BLOCKCHAIN (Required)
# =============================================================================
# PollPool contract address (DEPLOY NEW FOR MAINNET)
POLLPOOL_CONTRACT_ADDRESS=0x_YOUR_MAINNET_CONTRACT_ADDRESS

# RPC URL (change to mainnet for production)
# Testnet: https://sepolia.base.org
# Mainnet: https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org

# USDC contract address
# Testnet: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# =============================================================================
# WALLET KEYS (Required - GENERATE NEW FOR PRODUCTION)
# =============================================================================
# CRITICAL: Never reuse testnet keys in production!
# Generate new wallets and fund with ETH for gas

# Creator wallet - funds polls with USDC
CREATOR_PRIVATE_KEY=0x_NEW_PRIVATE_KEY_FOR_PRODUCTION

# Attestation signer - signs attestations for poll responses
ATTESTATION_SIGNER_ADDRESS=0x_CORRESPONDING_PUBLIC_ADDRESS
ATTESTATION_SIGNER_KEY=0x_NEW_PRIVATE_KEY_FOR_PRODUCTION

# =============================================================================
# COINBASE CDP (Optional - for agent wallet features)
# =============================================================================
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret
CDP_WALLET_SECRET=your-cdp-wallet-secret
TREASURY_ADDRESS=0x_YOUR_TREASURY_WALLET

# =============================================================================
# THIRDWEB (Required)
# =============================================================================
# Get from: https://thirdweb.com/dashboard
THIRDWEB_CLIENT_ID=your-client-id
THIRDWEB_SECRET_KEY=your-secret-key

# =============================================================================
# SERVER (Required)
# =============================================================================
PORT=3001
NODE_ENV=production

# CORS - set to your frontend domain
CORS_ORIGIN=https://pollin.cash
